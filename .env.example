# Copy to .env for local development. On Railway, set these in the service's Variables tab instead.

# Local Postgres from `docker compose up db`. On Railway use a reference variable:
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://get_around:get_around@localhost:5432/get_around

# Railway injects PORT automatically; locally the API listens on 8787.
PORT=8787
LOG_LEVEL=info
